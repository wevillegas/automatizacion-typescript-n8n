generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id        String   @id @default(cuid())
  requestId String
  toolName  String
  args      Json
  result    Json?
  risk      String
  decidedBy String? // null si fue automático, o el usuario que aprobó/rechazó
  createdAt DateTime @default(now())
}

model PendingApproval {
  id        String   @id @default(cuid())
  requestId String   @unique
  toolName  String
  args      Json
  callId    String // id de la tool call del modelo, para reinsertar su resultado al reanudar
  messages  Json // historial de LLMMessage[] en el punto de corte, para reanudar el loop
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())
}

model User {
  id      String   @id
  name    String
  status  String // active | suspended | cancelada
  tickets Ticket[]
}

// Tickets de soporte que crea y consulta el agente. Se muestran como TCK-<id>.
model Ticket {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  category  String
  summary   String
  status    String   @default("abierto") // abierto | cerrado
  createdAt DateTime @default(now())

  @@index([userId])
}

// Una fila por solicitud entrante: es lo que lee el dashboard.
model Request {
  id        String   @id @default(cuid())
  requestId String   @unique
  message   String
  status    String // resolved | pending | approved | rejected
  response  String? // texto final del agente
  toolName  String? // tool que quedó esperando aprobación
  args      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
